{
  "name": "web",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "targets": {
    "dev": {
      "command": "vite --host",
      "options": {
        "cwd": "apps/web"
      }
    },
    "build": {
      "command": "vite build",
      "options": {
        "cwd": "apps/web"
      },
      "dependsOn": ["^build"]
    },
    "preview": {
      "command": "vite preview",
      "options": {
        "cwd": "apps/web"
      }
    }
  }
}
